# Replace every demo value before using the project outside an isolated demo.
RUNLOOP_API_KEY=replace-with-your-runloop-api-key
RUNLOOP_TUNNEL_AUTH=open

CONTROL_TOKEN=replace-with-a-random-control-token
SERVICE_CONTROL_TOKEN=replace-with-a-random-service-token
RESEARCHER_AGENT_TOKEN=replace-with-a-random-researcher-token
DEPLOYER_AGENT_TOKEN=replace-with-a-random-deployer-token
UNTRUSTED_AGENT_TOKEN=replace-with-a-random-untrusted-token
LOAD_TESTER_AGENT_TOKEN=replace-with-a-random-load-tester-token
INCIDENT_RESPONDER_AGENT_TOKEN=replace-with-a-random-incident-token
